@SolidClass base(Trigger, Targetname) = trigger_horde_holdzone : "HORDE: зона удержания (hold objective)."
[
	wave(integer) : "Wave" : 0 : "Волна, на которой зона активна. 0 = все волны."
	group(integer) : "Group" : 0 : "Группа зон. По умолчанию из группы берётся одна случайная; при combine=1 — все сразу."
	label(string) : "Label" : "the area" : "Подпись в уведомлении («Defend and hold …»)."
	combine(choices) : "Combine group" : 0 : "Все зоны группы — одно задание (иначе одна случайная)." =
	[
		0 : "No (pick one)"
		1 : "Yes (all active)"
	]
	link(integer) : "Link" : 0 : "Связь с info_horde_payload_spawn с тем же link: удержание + доставка = одно задание."
	shape(choices) : "Shape" : 0 : "Форма зоны. Браш всегда остаётся ориентиром; цилиндр рисуется и проверяется логически." =
	[
		0 : "Box (brush)"
		1 : "Cylinder"
	]
	radius(float) : "Cylinder radius" : "0" : "Радиус цилиндра (shape=1). 0 = половина размера браша по X/Y."
	height(float) : "Cylinder height" : "0" : "Высота цилиндра (shape=1). 0 = высота браша."
	parent(target_destination) : "Parent" : : "targetname сущности, за которой едет зона (например func_physbox)."
	parentname(target_destination) : "Parent name (alias)" : : "Алиас parent — то же самое."
	fixedorientation(choices) : "Fixed orientation" : 0 : "Если Yes — зона едет за parent только по позиции, углы всегда вверх (не крутится с physbox). No — как сейчас: крутится вместе с parent." =
	[
		0 : "No (follow parent angles)"
		1 : "Yes (always upright)"
	]
	disabled(choices) : "Start disabled" : 0 =
	[
		0 : "No"
		1 : "Yes"
	]

	OnCompleted(output) : "Срабатывает, когда зона удержана на 100%."

	input Enable(void) : "Включить зону."
	input Disable(void) : "Выключить зону."
	input Toggle(void) : "Переключить."
	input SetParent(string) : "Привязать к сущности по targetname (зона едет вместе с ней)."
	input SetGroup(integer) : "Сменить group."
	input SetLink(integer) : "Сменить link."
	input SetShape(integer) : "0 = box, 1 = cylinder."
	input SetRadius(float) : "Сменить радиус цилиндра."
	input SetFixedOrientation(integer) : "0 = крутиться с parent, 1 = всегда вверх."
]

