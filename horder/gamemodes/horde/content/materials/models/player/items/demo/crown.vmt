"VertexlitGeneric"
{
	"$baseTexture" "models/player/items/demo/crown"
	"$env_map" "env_cubemap"
	"$envmaptint" "[.5 .5 .5]"
	"$yellow" "0"

	"$phong" "1"
	"$phongexponent" "50"
	"$phongboost" "8"
	"$phongfresnelranges"	"[.25 .5 1]"

 	"$blendtintbybasealpha" "1" 
 	"$blendtintcoloroverbase" "0"  

	"$colortint_base" "{127 61 61}"
	"$colortint_tmp" "[0 0 0]" 

	"Proxies"
	{
		"invis"
		{
		}
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" 30
		}
		"SelectFirstIfNonZero"
		{
			"srcVar1"	"$colortint_tmp"
			"srcVar2"	"$colortint_base"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}