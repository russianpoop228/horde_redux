@BaseClass = HordeTargetname
[
	targetname(string) : "Name" : : "Entity name (for I/O and parenting)."
]

@BaseClass = HordeOrigin
[
	origin(string) : "Origin (X Y Z)" : "0 0 0" : "World position."
]

@PointClass base(HordeTargetname, HordeOrigin) studio("models/editor/axis_helper.mdl") = info_horde_difficulty : "HORDE: map difficulty / modifier (on map start and via inputs)."
[
	difficulty(string) : "Difficulty" : : "CASUAL, NORMAL, HARD, NIGHTMARE, APOCALYPSE, CHAOS..."
	modifier(string) : "Modifier" : : "BOSS_RUSH, UNARMED, HUNDRED, PURISM, WAVE_666..."
	base(string) : "Modifier base (Include)" : : "Base difficulty for the modifier. Empty = gamemode default."
	enabled(choices) : "Apply on map start" : 1 =
	[
		0 : "No"
		1 : "Yes"
	]
	custom(choices) : "Create custom difficulty" : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
	name(string) : "Custom name" : : "Custom difficulty name (when custom=1)."
	index(integer) : "Custom index" : : "Custom difficulty index. Empty = first free."

	damagemult(string) : "DamageMult" : : "Enemy damage multiplier."
	healthmult(string) : "HealthMult" : : "Enemy health multiplier."
	rewardmult(string) : "RewardMult" : : "Reward multiplier."
	startmoneymult(string) : "StartMoneyMult" : : "Starting money multiplier."
	enemycountmult(string) : "EnemyCountMult" : : "Enemy count multiplier."
	spawnradiusmult(string) : "SpawnRadiusMult" : : "Spawn radius multiplier."
	maxenemiesscalefactor(string) : "MaxEnemiesScaleFactor" : : "Alive enemy limit scale."
	additionalpack(string) : "AdditionalPack" : : "Additional packs."
	additionalammoboxes(string) : "AdditionalAmmoBoxes" : : "Additional ammo boxes."
	additionalenemiesperspawn(string) : "AdditionalEnemiesPerSpawn" : : "Additional enemies per spawn."
	enemiesperspawnwavestep(string) : "EnemiesPerSpawnWaveStep" : : ""
	enemiesperspawnwaveamount(string) : "EnemiesPerSpawnWaveAmount" : : ""
	enemiesperspawnwavecap(string) : "EnemiesPerSpawnWaveCap" : : ""
	spawnspeedmult(string) : "SpawnSpeedMult" : : ""
	spawninterval(string) : "SpawnInterval" : : ""
	spawnintervalwavestep(string) : "SpawnIntervalWaveStep" : : ""
	spawnintervalwaveamount(string) : "SpawnIntervalWaveAmount" : : ""
	spawnintervalwavecap(string) : "SpawnIntervalWaveCap" : : ""
	maxenemiesalivebase(string) : "MaxEnemiesAliveBase" : : ""
	maxenemiesaliveperplayer(string) : "MaxEnemiesAlivePerPlayer" : : ""
	maxenemiesalivecap(string) : "MaxEnemiesAliveCap" : : ""
	statusdurationbonus(string) : "StatusDurationBonus" : : ""
	breakhealthleft(string) : "BreakHealthLeft" : : ""
	shockdamageincrease(string) : "ShockDamageIncrease" : : ""
	frostbiteslow(string) : "FrostbiteSlow" : : ""
	poisonheadcrabdamage(string) : "PoisonHeadcrabDamage" : : ""
	elitehealthscaleadd(string) : "EliteHealthScaleAdd" : : ""
	elitehealthscalemultiplier(string) : "EliteHealthScaleMultiplier" : : ""
	mutationprobability(string) : "MutationProbability" : : ""
	elitemutationprobability(string) : "EliteMutationProbability" : : ""

	input SetDifficulty(string) : "Base difficulty (name)."
	input SetModifier(string) : "Modifier (name)."
	input ClearModifier(void) : "Remove the modifier."
	input SetBase(string) : "Modifier base (Include)."
	input SetParameter(string) : "Field Value, e.g. DamageMult 1.5"
	input ResetParameters(void) : "Reset parameters."
	input CreateCustom(string) : "Name [Index] [Base]"
	input Enable(void) : "Enable applying."
	input Disable(void) : "Disable applying."
	input Toggle(void) : "Toggle enabled."
	input Apply(void) : "Apply now."
]

@SolidClass base(HordeTargetname) = trigger_horde_holdzone : "HORDE: hold zone. Supports shape, parent and fixed orientation."
[
	wave(integer) : "Wave" : 0 : "0 = every wave."
	group(integer) : "Group" : 0 : "Zone group."
	label(string) : "Label" : "the area" : "Text shown in notifications."
	combine(choices) : "Combine group" : 0 =
	[
		0 : "No (pick one)"
		1 : "Yes (all active)"
	]
	link(integer) : "Link" : 0 : "Link to a payload spawn (one objective)."
	shape(choices) : "Shape" : 0 : "0 = brush box, 1 = in-game cylinder." =
	[
		0 : "Box (brush)"
		1 : "Cylinder"
	]
	radius(string) : "Cylinder radius" : "0" : "Radius. 0 = half of the brush XY size."
	height(string) : "Cylinder height" : "0" : "Cylinder height. 0 = brush height."
	parent(string) : "Parent" : : "Targetname of a func_physbox (or any other entity)."
	parentname(string) : "Parent name (alias)" : : "Same as Parent."
	fixedorientation(choices) : "Fixed orientation" : 0 : "Yes = moves with the parent but does not rotate." =
	[
		0 : "No (follow parent angles)"
		1 : "Yes (always upright)"
	]
	disabled(choices) : "Start disabled" : 0 =
	[
		0 : "No"
		1 : "Yes"
	]

	output OnCompleted(void) : "Zone held to 100%."

	input Enable(void) : "Enable"
	input Disable(void) : "Disable"
	input Toggle(void) : "Toggle"
	input SetParent(string) : "Parent to targetname."
	input SetGroup(integer) : "Set group"
	input SetLink(integer) : "Set link"
	input SetShape(integer) : "0=box 1=cylinder"
	input SetRadius(string) : "Cylinder radius"
	input SetFixedOrientation(integer) : "0 = follow parent angles, 1 = always upright"
]

